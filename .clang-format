Language: Cpp
# BasedOnStyle

TabWidth:          8
UseTab:            Always
IndentWidth:       3
ContinuationIndentWidth: 3
ColumnLimit:       0
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AccessModifierOffset: 0
AlwaysBreakTemplateDeclarations: No
RequiresClausePosition: SingleLine
IndentRequiresClause: true
IncludeCategories:
  - Regex:           'apti18n.h'
    Priority:        9999
  - Regex:           'apt-[^/]*/'
    Priority:        20
  - Regex:           '^"'
    Priority:        10
  - Regex:           'config.h'
    Priority:        0
  - Regex:           '(zlib|bzlib|lzma|lz4frame|gtest/gtest|db|gnutls/.*)\.h'
    Priority:        30
  - Regex:           '\.h'
    Priority:        100
  - Regex:           '.*'
    Priority:        99
