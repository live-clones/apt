#!/bin/sh
#
# Ensure that when going from unauthenticated to authenticated all
# files are checked again
#
set -e

TESTDIR="$(readlink -f "$(dirname "$0")")"
. "$TESTDIR/framework"

umask 022

setupenvironment
configarchitecture "i386"
configcompression '.' 'xz'

insertpackage 'unstable' 'foo' 'i386' '1.0'
insertsource 'unstable' 'foo' 'any' '1.0'

setupaptarchive --no-update
changetowebserver

runtest() {
    # start unauthenticated
    rm -rf rootdir/var/lib/apt/lists/
    find aptarchive/ \( -name 'InRelease' -o -name 'Release.gpg' \) -delete

    testwarning aptget update --allow-insecure-repositories

    # become authenticated
    generatereleasefiles
    signreleasefiles

    # the index files were verified against the unsigned Release file
    # already, so if the signed one has the same hashes for them the
    # update can carry them over to the authenticated repository
    PKGS=$(ls rootdir/var/lib/apt/lists/*Packages* | head -n 1)
    cp "$PKGS" packages.before
    testsuccess aptget update
    testsuccess cmp "$PKGS" packages.before
    testsuccess ls rootdir/var/lib/apt/lists/*_InRelease
    testfailure ls rootdir/var/lib/apt/lists/*_Release

    # change an index file so its hash in the Release file changes:
    # it has to be downloaded and verified again
    cat >> aptarchive/dists/unstable/main/binary-i386/Packages <<EOF

Package: newpkg
Architecture: all
Version: 1
Filename: pool/newpkg_1_all.deb
Size: 1
Description: an autogenerated new package
EOF
    compressfile aptarchive/dists/unstable/main/binary-i386/Packages
    generatereleasefiles
    # avoid an ims hit of the InRelease file by dating it into the future
    touch -d '+1 hour' aptarchive/dists/unstable/Release
    signreleasefiles
    testsuccess aptget update
    testsuccessequal 'newpkg' aptcache pkgnames newpkg
}

for COMPRESSEDINDEXES in 'false' 'true'; do
	echo "Acquire::GzipIndexes \"$COMPRESSEDINDEXES\";" > rootdir/etc/apt/apt.conf.d/compressindexes
	if $COMPRESSEDINDEXES; then
		msgmsg 'Run tests with GzipIndexes enabled'
	else
		msgmsg 'Run tests with GzipIndexes disabled'
	fi
	runtest
done
